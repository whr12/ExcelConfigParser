                    $"{index} is out of range [0, {dataList.DatasLength})");
            }

            var unit = dataList.Datas(index);
            if (unit != null)
            {
                #DATA_NAME# data = unit.Value;
                CacheData(data.Id, data);
                return data;
            }

            return default;
        }

        public void LoadDataFromFolder(string folderPath)
        {
            byte[] bytes = File.ReadAllBytes(folderPath + bytesFileName);
            byteBuffer = new ByteBuffer(bytes);
            dataList = #DATA_LIST_NAME#.GetRootAsBattleUnitList(byteBuffer);
        }

